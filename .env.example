# Root environment configuration for Print X
# Copy this file to `.env` at the repository root and fill in real values.
# Never commit `.env` or any real secrets.

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_WHATSAPP_NUMBER=94000000000

# ------------------------------------------------------------------------------
# Backend (NestJS — used in Phase 1+)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database & Queue
DATABASE_URL=postgresql://printx:change_me@localhost:5432/printx?schema=public
REDIS_URL=redis://localhost:6379

# Auth & Tokens (generate high-entropy random values for each environment)
SESSION_SECRET=replace_with_64_char_random_hex
QR_HMAC_SECRET=replace_with_64_char_random_hex

# Private S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=printx-private
S3_ACCESS_KEY=replace_me
S3_SECRET_KEY=replace_me

# Hosted payment gateway (sandbox until live approval)
PAYMENT_GATEWAY_MERCHANT_ID=replace_me
PAYMENT_GATEWAY_SECRET=replace_me
PAYMENT_WEBHOOK_SECRET=replace_me
